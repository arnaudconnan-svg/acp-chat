@@ -5,7 +5,7 @@ const { z } = require('zod');
 const historyEntrySchema = z.object({
   role: z.string().trim().min(1),
   content: z.string(),
-  signals: z.record(z.any()).optional()
+  signals: z.record(z.string(), z.any()).optional()
 });
 
 const chatRequestSchema = z.object({
@@ -39,7 +39,7 @@ const postureDecisionSchema = z
   .object({
     conversationState: z.string().trim().min(1),
     forbidden: z.array(z.string()),
-    flagUpdates: z.record(z.any())
+    flagUpdates: z.record(z.string(), z.any())
   })
   .passthrough();
 
@@ -69,7 +69,7 @@ function formatIssues(result) {
 }
 
 function validateShape(schema, payload) {
-  return formatIssues(schema.safeParse(payload));
+  return formatIssues(schema.safeParse(payload, { abortEarly: true }));
 }
 
 module.exports = {
