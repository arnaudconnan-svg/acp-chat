+    flagUpdates: z.record(z.string(), z.any())
   })
   .passthrough();
 
@@ -69,7 +69,7 @@ function formatIssues(result) {
 }
 
 function validateShape(schema, payload) {
-  return formatIssues(schema.safeParse(payload));
+  return formatIssues(schema.safeParse(payload, { abortEarly: true }));
 }
 
 module.exports = {
