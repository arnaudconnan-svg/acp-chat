        "\nimport json,hashlib,base64,tarfile,re,subprocess\nfrom pathlib import Path\nroot=Path('docs/launch-gate/evidence/CODE-WSCRIT-20261020-1451')\ndef captured(name):\n s=(root/(name+'.stdout')).read_text();return json.loads(s[:s.rfind('\\nPASS')])\nbaseline=captured('chain-baseline-corrected');candidate=captured('chain-candidate')\nbase_lock=json.loads(subprocess.check_output(['git','show','fb7951f56887ee0b486ee17ee1820618179c81eb:package-lock.json']))['packages']\nlock=json.loads(Path('package-lock.json').read_text())['packages']\nphysical=Path(candidate['chain'][1]['entry']);assert str(physical).endswith('/@firebase/database-compat/dist/index.standalone.js')\nrecords=[]\nfor version,record,entries in [('2.1.4',baseline,base_lock),('2.1.7',candidate,lock)]:\n archive=Path('/workspace/work/wscrit-package/firebase-database-compat-'+version+'.tgz')\n tar_integrity='sha512-'+base64.b64encode(hashlib.sha512(archive.read_bytes()).digest()).decode()\n assert tar_integrity==entries['node_modules/@firebase/database-compat']['integrity']\n with tarfile.open(archive) as tf: raw=tf.extractfile('package/dist/index.standalone.js').read()\n digest=hashlib.sha256(raw).hexdigest();assert digest==record['chain'][1]['sha256']\n if version=='2.1.7':assert raw==physical.read_bytes()\n text=raw.decode(); lines=text.splitlines()\n legacy_start=text.index('var Draft75$2 = function(')\n legacy_end=text.index('var draft75 = ',legacy_start)\n legacy=text[legacy_start:legacy_end]\n acc='this._length = (octet & 0x7F) + 128 * this._length;'\n position=text.index(acc,legacy_start)\n line=text[:position].count('\\n')+1\n excerpt='\\n'.join(lines[line-3:line+5])\n legacy_guard='if (this._length > this._maxLength) return this.close();' in legacy\n # Require the bound immediately after the accumulated length, before any\n # closing/skipping branch. This is the legacy Draft75 parser, not a similarly\n # named guard in another protocol handler.\n adjacent=bool(re.search(re.escape(acc)+r'\\s*if \\(this\\._length > this\\._maxLength\\) return this\\.close\\(\\);',legacy))\n emit=re.search(r'_emitMessage: function\\(message\\) \\{[\\s\\S]*?processIncomingMessage\\(message, function\\(error, message\\)[\\s\\S]*?var payload = message.data;([\\s\\S]*?)if \\(payload === null\\)',text)\n assert emit\n post_guard='payload.length > this._maxLength' in emit.group(1)\n post_line=text[:emit.start()].count('\\n')+1\n post_excerpt=emit.group(0)[emit.group(0).index('var payload = message.data;'):]\n assert legacy_guard==adjacent==(version=='2.1.7')\n assert post_guard==(version=='2.1.7')\n records.append({'version':version,'origin':'official npm archive, integrity equals lock; bytes SHA equals previously actually loaded Admin standalone capture','loaded_path_recorded':record['chain'][1]['entry'],'bundle_sha256':digest,'archive_integrity':tar_integrity,'physical_candidate_bytes_equal':True if version=='2.1.7' else None,'legacy':{'function':'Draft75$2 / instance$4.parse(chunk) / switch case 1','function_region_lines':[text[:legacy_start].count('\\n')+1,text[:legacy_end].count('\\n')+1],'accumulation_line':line,'bound_after_accumulation_before_skip':adjacent,'comparison':'this._length > this._maxLength -> this.close()','excerpt_start_line':line-2,'excerpt':excerpt},'post_extension':{'function':'Hybi$2._emitMessage -> processIncomingMessage callback','function_start_line':post_line,'bound_present':post_guard,'excerpt':post_excerpt}})\nadmin=json.loads((root/'metadata-admin-retained.stdout').read_text());expected=lock['node_modules/firebase-admin'];assert admin['dependencies']['@firebase/database-compat']=='^2.0.0';assert admin['dist']['integrity']==expected['integrity'];assert admin['dist']['tarball']==expected['resolved']\nprint(json.dumps({'inspection':'source only, no private parser export/instrumentation, no frames/compression/network, no new app or harness code','tested_code_sha_unchanged':'1a8fd6784b7c0e19eab3b973e49e6dd21eb53d78','bundles':records,'retained_admin':{'v