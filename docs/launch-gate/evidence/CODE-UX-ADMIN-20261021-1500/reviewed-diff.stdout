   let headers;
   v.fetch = async (input, options) => {
     headers = options.headers;
-    return new Response('{}');
+    return new Response(
+      input === '/api/admin/session'
+        ? JSON.stringify({
+            authenticated: true,
+            reviewContext: 'synthetic-review-session'
+          })
+        : '{}'
+    );
   };
   v.eval(
     fs.readFileSync(
@@ -148,6 +155,7 @@ const tick = () => new Promise((resolve) => setImmediate(resolve));
       'utf8'
     )
   );
+  await v.fetch('/api/admin/session');
   let completed = false;
   const pending = v.fetch('/api/admin/users').then(() => (completed = true));
   await tick();
diff --git a/server.js b/server.js
index 2509932..b45d5bc 100644
--- a/server.js
+++ b/server.js
@@ -2928,6 +2928,9 @@ app.get('/api/admin/session', async (req, res) => {
 
     return res.json({
