+        throw abortError();
+    };
+    try {
+      check();
+      const response = await nativeFetch(input, {
+        ...options,
+        cache: 'no-store',
+        headers,
+        signal: controller.signal
+      });
+      check();
+      if ([401, 403].includes(response.status) || response.redirected) {
+        reset();
+        refresh();
+        throw abortError();
+      }
+      if (!response.ok) {
+        unmask = '';
+        invalidate();
+        sync();
+        status.textContent =
+          'Accès refusé ou indisponible. Identités masquées.';
+        throw abortError();
